{
  // Web estática (next build → out/) + API de valoraciones en /api/* (worker/index.ts).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curvatura",
  "account_id": "7da596b0f3d9c43df2882b4e9167079e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "curvatura", "database_id": "9283ffea-09d5-45df-afe3-8cf753d25f4e", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "DOCS", "id": "3d972ee45a7c476596d4cfc2e8293d78" }],
  "vars": {
    "SITE_URL": "https://curvatura.consultora-bim.workers.dev",
    "ORCID_BASE": "https://orcid.org",
    "ADMIN_ORCIDS": ""
  },
  // Secretos (bunx wrangler secret put …): ORCID_CLIENT_ID, ORCID_CLIENT_SECRET.
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
