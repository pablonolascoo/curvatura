{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curvatura",
  "version": "../../../version.json",
  "identifier": "io.github.pablonolascoo.curvatura",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3217",
    "beforeDevCommand": "cd ../web && bun run dev --port 3217",
    "beforeBuildCommand": "cd ../web && bun run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Curvatura",
        "url": "/es/",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Biblioteca, ecuaciones y laboratorio del motor de curvatura.",
    "copyright": "© 2026 Pablo Nolasco. PolyForm Noncommercial 1.0.0.",
    "license": "PolyForm-Noncommercial-1.0.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } },
    "linux": { "deb": { "depends": [] } }
  }
}
