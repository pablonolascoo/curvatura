{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curvatura",
  "version": "../../../version.json",
  "identifier": "io.github.pablonolascoo.curvatura",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3217",
    "beforeDevCommand": "cd ../web && bun run dev --port 3217",
    "beforeBuildCommand": "cd ../web && bun run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Curvatura",
        "url": "/es/",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#fbfbfa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Education",
    "shortDescription": "Biblioteca, ecuaciones y laboratorio del motor de curvatura.",
    "copyright": "© 2026 Pablo Nolasco. PolyForm Noncommercial 1.0.0.",
    "license": "PolyForm-Noncommercial-1.0.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "../../../physics/curvatura/": "python/curvatura/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzRDdGQ0M4MzIwMjJDNzkKUldSNUxBSXl5UHpYbzhqMVg5a21YNmkzaXVnSmt1dGpWWGdQOFI3cEtEZ0QwbWF1dmhUdTBMbzAK",
      "endpoints": [
        "https://github.com/pablonolascoo/curvatura/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
